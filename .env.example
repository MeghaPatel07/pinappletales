# =============================================================================
# Pineappletales — environment
#
# Copy to `.env` and fill in the blanks. `.env` is gitignored.
#
# ANYTHING PREFIXED `VITE_` IS COMPILED INTO THE BROWSER BUNDLE AND IS PUBLIC.
# Never put the Cloudinary API secret behind a VITE_ name.
# =============================================================================

# Production origin, no trailing slash. Drives canonicals, OG URLs and sitemap.
VITE_SITE_URL=https://www.pineappletales.com


# -----------------------------------------------------------------------------
# Firebase — Console → Project settings → General → Your apps → Web app → Config
#
# These are public by design; Firestore is protected by firestore.rules, not by
# hiding these values.
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pineappletales.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pineappletales
VITE_FIREBASE_STORAGE_BUCKET=pineappletales.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=789962858904
VITE_FIREBASE_APP_ID=


# -----------------------------------------------------------------------------
# Cloudinary — Console → Settings → Product environment (the "cloud name")
# -----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=

# Unsigned upload path (the default — no server required).
# Console → Settings → Upload → Upload presets → Add: signing mode "Unsigned".
# Lock it down: folder `pineappletales`, allowed formats jpg/png/webp/avif,
# max file size ~5MB.
VITE_CLOUDINARY_UPLOAD_PRESET=pineappletales_unsigned

# Signed upload path (optional). Leave EMPTY to stay on the unsigned path.
# When set, the admin asks this endpoint for a per-upload signature instead of
# using the preset. Deploy api/cloudinary-sign.js to Vercel/Netlify/Cloudflare
# and point this at it, e.g. /api/cloudinary-sign
VITE_CLOUDINARY_SIGNATURE_URL=


# -----------------------------------------------------------------------------
# Server-only. No VITE_ prefix, so these never reach the browser bundle.
# Used exclusively by api/cloudinary-sign.js. Set them as environment variables
# in your hosting dashboard, not in committed files.
# -----------------------------------------------------------------------------
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
