# =============================================================================
# Pineappletales — environment
#
# Copy to `.env` and fill in the blanks. `.env` is gitignored.
#
# ANYTHING PREFIXED `NEXT_PUBLIC_` IS COMPILED INTO THE BROWSER BUNDLE AND IS
# PUBLIC. Never put a secret behind a NEXT_PUBLIC_ name.
# =============================================================================

# Production origin, no trailing slash. Drives canonicals, OG URLs and the
# sitemap.
NEXT_PUBLIC_SITE_URL=https://www.pineappletales.com


# -----------------------------------------------------------------------------
# MongoDB — connection string for your Atlas cluster (or local mongod).
# -----------------------------------------------------------------------------
MONGODB_URI=


# -----------------------------------------------------------------------------
# JWT — used to sign the admin's access and refresh tokens.
# Generate strong random values, e.g.: openssl rand -base64 48
# Keep both secret; never commit real values.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=


# -----------------------------------------------------------------------------
# Cloudinary — Console → Settings → Product environment (the "cloud name")
# Uploads always go through the signed path (/api/admin/uploads/sign), which
# is why the API key/secret are needed here even though there's no separate
# upload-signing server to deploy any more.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# -----------------------------------------------------------------------------
# One-off migration script only (scripts/migrate-firestore-to-mongo.mjs).
# Not needed for normal running of the site — only to port old Firestore
# content into MongoDB once. MIGRATION_ADMIN_EMAIL/PASSWORD must be an
# existing Firestore admin login, since only an admin can read drafts.
# -----------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=pineappletales
MIGRATION_ADMIN_EMAIL=
MIGRATION_ADMIN_PASSWORD=
